{{template "header" .}}
<main>
  <nav class="crumbs"><a href="/">Skemat</a> › <a href="/catalog/makes/{{.Make.ID}}">{{.Make.Name}}</a> › <span>{{.Model.DisplayName}}</span></nav>
  <h1>{{.Model.DisplayName}}</h1>
  <p class="muted">
    {{if .CargoYear}}model year {{.CargoYear}} · {{end}}{{.Make.Name}} · edition {{.Model.DatasetYear}}{{if .Model.Region}} · {{.Model.Region}}{{end}}
  </p>
  <ul class="stack">
    {{range .Systems}}
    <li><a class="row" href="/system/{{.ID}}">System {{.Code}}</a></li>
    {{else}}<li>No systems</li>{{end}}
  </ul>
</main>
{{template "footer" .}}