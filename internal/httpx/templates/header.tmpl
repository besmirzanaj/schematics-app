{{define "header"}}<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Skemat — Schematics</title>
  <link rel="stylesheet" href="/static/app.css">
  <script src="/static/htmx.min.js"></script>
</head>
<body>
<header class="top">
  <a class="brand" href="/">Skemat</a>
  <form class="search" action="/search" method="get">
    <input name="q" placeholder="Search make, model, system…" value="{{.Q}}">
    <button>Search</button>
  </form>
  <nav>
    {{if .User}}<span>{{.User.Email}}</span>
      {{if eq .User.Role "admin"}}<a href="/admin/users">Admin</a>{{end}}
      <form method="post" action="/logout" style="display:inline"><button>Logout</button></form>
    {{end}}
  </nav>
</header>
{{end}}