{{template "header" .}}
<main>
  <h1>Browse by brand</h1>
  <ul class="grid brands">
    {{range .Brands}}
    <li><a class="bcard" href="/catalog/makes/{{.ID}}">
      <div class="bname">{{.Name}}</div>
      <div class="bmeta">{{.ModelCount}} models{{range .Editions}} · <span class="chip">{{.}}</span>{{end}}</div>
    </a></li>
    {{else}}<li class="row">No brands in your plan.</li>{{end}}
  </ul>
</main>
{{template "footer" .}}