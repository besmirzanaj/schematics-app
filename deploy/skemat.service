[Unit]
Description=Skemat schematics server
After=network-online.target
Wants=network-online.target

[Service]
User=skemat
Group=skemat
WorkingDirectory=/srv/skemat
EnvironmentFile=/etc/skemat.env
ExecStart=/usr/local/bin/skemat-server
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/skemat/data

[Install]
WantedBy=multi-user.target